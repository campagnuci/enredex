# Production settings — copy to .env.prod and edit
# --------------------------------------------------
# Database
POSTGRES_USER=enredex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enredex

# API
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Domains
API_HOST=api.enredex.example.com
WEB_HOST=enredex.example.com

# Email (optional — omit SMTP_URL to log to console)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Enredex <no-reply@enredex.example.com>

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com
